---
interface Props { poster: string; video: string; alt: string; }
const { poster, video, alt } = Astro.props;
---
<figure class="motion-photo">
  <video poster={poster} controls playsinline preload="none" muted aria-label={alt}>
    <source src={video} type="video/mp4" />
    您的浏览器暂不支持视频播放。<a href={video}>打开视频</a>
  </video>
  <figcaption>{alt} · 动态照片</figcaption>
</figure>
<style>
  figure { margin: 1.5rem 0; }
  video { width: 100%; height: auto; display: block; border-radius: 8px; }
  figcaption { font-size: .8rem; color: #706d64; margin-top: .5rem; }
</style>
