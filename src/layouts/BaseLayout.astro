---
import '../styles/global.css';
interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="十三天的西班牙旅行记录：巴塞罗那、马德里与六天朝圣之路。" />
    <meta name="theme-color" content="#f5f2e9" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <header><a class="brand" href="/">十三日 <span>SPAIN JOURNAL</span></a><a href="/#chapters">旅行章节 ↗</a></header>
    <main id="main"><slot /></main>
    <footer><span>西班牙 · 旅行手记</span><span>照片、片刻，以及走过的路。</span></footer>
  </body>
</html>
