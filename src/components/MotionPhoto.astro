---
interface Props { poster: string; video: string; alt: string; caption?: string; }
const { poster, video, alt, caption } = Astro.props;
---
<figure class="motion-photo">
  <div class="frame">
    <video poster={poster} controls playsinline preload="metadata" muted loop aria-label={alt}>
      <source src={video} type="video/mp4" />
      您的浏览器暂不支持视频播放。<a href={video}>打开视频</a>
    </video>
    <span class="badge" aria-hidden="true">LIVE</span>
  </div>
  <figcaption>{caption ?? alt} · 动态照片</figcaption>
</figure>
<style>
  figure { margin: 1.5rem 0; }
  .frame { position: relative; }
  video { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; border-radius: 4px; background: #dedccf; }
  .badge { position: absolute; top: 10px; left: 10px; padding: 3px 7px; border-radius: 99px; color: white; background: rgb(24 24 20 / 70%); font-size: 9px; letter-spacing: 1.4px; pointer-events: none; }
  figcaption { font-size: 12px; line-height: 1.55; color: #706d64; margin-top: 7px; }
</style>
