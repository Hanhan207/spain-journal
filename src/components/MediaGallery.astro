---
import MotionPhoto from './MotionPhoto.astro';
import type { MediaItem } from '../data/media';

interface Props {
  items: MediaItem[];
  label: string;
}

const { items, label } = Astro.props;
---

<div class:list={['media-gallery', { single: items.length === 1 }]} aria-label={label}>
  {items.map((item) => (
    item.kind === 'photo' ? (
      <figure class="media-item photo">
        <img
          src={item.src}
          alt={item.alt}
          width={item.width}
          height={item.height}
          loading="lazy"
          decoding="async"
        />
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ) : item.kind === 'motion' ? (
      <MotionPhoto
        poster={item.poster}
        video={item.src}
        alt={item.alt}
        caption={item.caption}
      />
    ) : (
      <figure class="media-item video">
        <video poster={item.poster} controls playsinline preload="metadata" aria-label={item.alt}>
          <source src={item.src} type="video/mp4" />
          您的浏览器暂不支持视频播放。<a href={item.src}>打开视频</a>
        </video>
        <figcaption>{item.caption ?? item.alt}</figcaption>
      </figure>
    )
  ))}
</div>

<script>
  document.addEventListener('play', (event) => {
    const current = event.target;
    if (!(current instanceof HTMLVideoElement)) return;
    document.querySelectorAll('video').forEach((video) => {
      if (video !== current) video.pause();
    });
  }, true);
</script>

<style>
  .media-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .media-item, :global(.media-gallery .motion-photo) { min-width: 0; margin: 0; }
  .media-item img, .media-item video { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; background: #dedccf; border-radius: 4px; }
  .media-item:nth-child(3n + 1), .single .media-item, :global(.media-gallery.single .motion-photo) { grid-column: 1 / -1; }
  .media-item:nth-child(3n + 1) img, .media-item:nth-child(3n + 1) video, .single .media-item img, .single .media-item video { aspect-ratio: 16 / 10; }
  figcaption { margin-top: 7px; color: #706d64; font-size: 12px; line-height: 1.55; }
  @media (min-width: 768px) { .media-gallery { gap: 16px; } }
</style>
